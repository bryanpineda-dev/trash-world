{
  "name": "trash-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny autonomous creature living inside your phone.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets": "node scripts/generate-assets.js && node scripts/generate-icons.js",
    "assets:check": "node scripts/generate-assets.js --check",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "build": "vite build",
    "postbuild": "node scripts/generate-sw.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "vite": "^8.3.3"
  },
  "dependencies": {
    "lucide": "^1.52.0"
  }
}
